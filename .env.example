NODE_ENV=development
PORT=9999
LOG_LEVEL=debug

# --- Local dev (docker-compose) ---
# Migration/owner connection. Owns the tables, so RLS does NOT apply to it.
DATABASE_URL=postgresql://school:school@localhost:5436/school_dev
TEST_DATABASE_URL=postgresql://school:school@localhost:5435/school_test
REDIS_URL=redis://localhost:6381

# The unprivileged runtime role (docker/init-app-role.sql). Optional today and
# read by nothing — the GRANTs and RLS policies it needs land with the first
# domain migration in step 2, and from then on this becomes the DSN the app
# serves traffic on while DATABASE_URL is used only to migrate.
# APP_DATABASE_URL=postgresql://school_app:school_app@localhost:5436/school_dev

# --- Neon (staging/prod — override DATABASE_URL with the Neon connection string) ---
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<db>?sslmode=require

# --- Auth (Better Auth) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:9999

# How many of YOUR OWN proxies sit in front of the app.
# 0 (default) = exposed directly, so X-Forwarded-For is ignored entirely.
# Trusting it when nothing rewrites it lets anyone reset their own rate limit
# by rotating the header. Set to the real hop count behind a load balancer;
# setting it too high reintroduces the bypass.
TRUST_PROXY_HOPS=0

# Addresses allowed to have written X-Forwarded-For, comma-separated.
#
# TRUST_PROXY_HOPS on its own assumes every request arrived through your proxy.
# If the app is ALSO reachable directly, an attacker connects to it, sends a
# chain of their own, and the bypass returns. You need ONE of:
#   - the app unreachable except through the proxy (bind it to loopback, or
#     keep it on a private network), or
#   - the proxy addresses listed here.
TRUSTED_PROXY_IPS=

# --- Google sign-in (optional; set BOTH or neither) ---
# Without these, email+password and phone OTP are unaffected — Google simply
# isn't offered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- The rest are optional in dev/test, required when NODE_ENV=production ---

# --- M-Pesa (Daraja) ---
#
# NOTE: these are the PLATFORM sandbox credentials, used for local development
# against Daraja's sandbox only. In production each school holds its own
# paybill and its own credentials, encrypted in `schools.mpesa_credentials` —
# money must never route through our account (CLAUDE.md §5.8). Nothing in
# production reads the shortcode below.
MPESA_ENV=sandbox            # sandbox | production — picks the Daraja host
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=          # must be a publicly reachable HTTPS URL (use ngrok locally)
# Comma-separated Safaricom source IPs allowed to POST the callback. Optional —
# Safaricom's published list changes. Leave blank to skip the IP check.
MPESA_CALLBACK_ALLOWED_IPS=

# --- Email (Resend) --- set BOTH or neither
# When set, email verification becomes REQUIRED for sign-up. Leave blank only
# in dev/test: without it, sign-up cannot prove the address belongs to the
# registrant.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Image CDN (ImageKit) ---
# Student photos and CBE portfolio evidence (score attachments).
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
