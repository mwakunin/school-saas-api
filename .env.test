NODE_ENV=test
PORT=9999
LOG_LEVEL=silent

# Points at the disposable tmpfs Postgres on :5435 (see docker-compose.yml).
# DATABASE_URL is ignored in test mode — env.ts resolves it to TEST_DATABASE_URL.
DATABASE_URL=postgresql://school:school@localhost:5435/school_test
TEST_DATABASE_URL=postgresql://school:school@localhost:5435/school_test
REDIS_URL=redis://localhost:6381

# Not a real secret — test fixture only.
BETTER_AUTH_SECRET=test-secret-not-used-in-production-0123456789
BETTER_AUTH_URL=http://localhost:9999

# Fake M-Pesa credentials — every Daraja call is mocked in tests, these only
# need to exist so the client can construct a request.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=test-consumer-key
MPESA_CONSUMER_SECRET=test-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=test-passkey
MPESA_CALLBACK_URL=https://example.test/mpesa/callback

# app.request() has no socket, so tests declare a trusted edge to make
# X-Forwarded-For meaningful. Production defaults to 0.
TRUST_PROXY_HOPS=1

# Fake ImageKit credentials — no upload or delete call reaches the network in
# tests, but the signing code is real and needs a key to sign with.
IMAGEKIT_PUBLIC_KEY=public_test_key
IMAGEKIT_PRIVATE_KEY=private_test_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/school-test
