{
  "name": "school-api",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@11.17.0",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "cross-env NODE_ENV=production node ./dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "cross-env NODE_ENV=test vitest",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage",
    "build": "tsc && tsc-alias",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:migrate:test": "cross-env NODE_ENV=test drizzle-kit migrate",
    "db:migrate:deploy": "node ./dist/src/db/migrate.js",
    "seed:demo": "cross-env LOG_LEVEL=warn tsx seed/index.ts",
    "seed:demo:deploy": "cross-env NODE_ENV=production LOG_LEVEL=warn node ./dist/seed/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.2",
    "@scalar/hono-api-reference": "^0.9.13",
    "better-auth": "^1.7.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^12.0.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.5",
    "hono-pino": "^0.10.3",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.1.1",
    "rate-limiter-flexible": "^11.2.0",
    "resend": "^6.24.0",
    "stoker": "2.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.1.0",
    "@types/node": "^24.2.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.32.0",
    "eslint-plugin-format": "^1.0.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  }
}
